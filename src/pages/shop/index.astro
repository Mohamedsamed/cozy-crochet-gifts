---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { activeCategories, publishedProducts } from '../../lib/store';
---
<BaseLayout
  title="Shop crochet patterns"
  description="Browse downloadable crochet PDF patterns and find a project for your next handmade gift."
>
  <div class="page-shell">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Shop' }]} />
    <header class="page-heading">
      <p class="eyebrow">The pattern shelf</p>
      <h1>Find a pattern for your next little project.</h1>
      <p>Browse digital crochet patterns with transparent details about format, materials, and skill level whenever those details are available.</p>
    </header>
    <ProductGrid products={publishedProducts} categories={activeCategories} searchable={true} />
  </div>
  <section class="section section-compact">
    <div class="page-shell">
      <p class="eyebrow">Still deciding?</p>
      <h2>Start with a little inspiration.</h2>
      <p class="muted">Our journal has practical notes on choosing a crochet gift and reading your first pattern.</p>
      <a class="text-link" href="/blog/">Browse the journal <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>