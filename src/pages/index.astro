---
import { getCollection } from 'astro:content';
import { ArrowRight, BookOpen, Download, Heart, ListChecks } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { activeCategories, publishedProducts } from '../lib/store';
import { siteConfig } from '../config/site';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = posts.slice(0, 3);
const featuredProducts = publishedProducts.filter((product) => product.featured).slice(0, 3);
const bestsellers = publishedProducts.filter((product) => product.badge === 'bestseller').slice(0, 3);
const giftCategory = activeCategories.find((category) => category.slug === 'crochet-gifts');
const heroSchema = siteConfig.publicSiteUrl
  ? [{
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteConfig.name,
      url: siteConfig.publicSiteUrl,
      inLanguage: 'en-US',
    }]
  : [];
---
<BaseLayout
  title="Crochet patterns for thoughtful handmade gifts"
  description="Discover digital crochet PDF patterns, amigurumi ideas, and practical inspiration for handmade gifts."
  image="/images/home-crochet-still-life-1200.jpg"
  preloadImage={true}
  schemas={heroSchema}
>
  <section class="hero" aria-labelledby="hero-title">
    <picture>
      <source type="image/jpeg" srcset="/images/home-crochet-still-life-768.jpg 768w, /images/home-crochet-still-life-1200.jpg 1200w, /images/home-crochet-still-life-1536.jpg 1536w" sizes="100vw" />
      <img class="hero-image" src="/images/home-crochet-still-life-1200.jpg" alt="Hand-crocheted bunny, textured crochet blanket, yarn, and a wooden hook in a sunlit studio." width="1200" height="800" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-shade"></div>
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-kicker">A little joy, made by hand</p>
        <h1 id="hero-title">Make something beautiful, one stitch at a time.</h1>
        <p>Thoughtful crochet patterns and gentle inspiration for the projects you make, keep, and give.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/shop/">Explore crochet patterns <ArrowRight size={17} aria-hidden="true" /></a>
          <a class="text-link" href="/blog/choosing-a-crochet-gift-pattern/">Browse gift ideas <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
      </div>
    </div>
    <span class="hero-note">A handmade life, one little project at a time</span>
  </section>

  <section class="section">
    <div class="page-shell intro-band">
      <div>
        <p class="eyebrow">Made for the making</p>
        <h2>Good patterns make room for the joy of crochet.</h2>
      </div>
      <div class="intro-band-copy">
        <p>Cozy Crochet Gifts brings together digital crochet patterns, amigurumi projects, and useful ideas for handmade gifting. Each pattern is presented with the details we have, so you can choose a project that feels right for you.</p>
        <p>When a pattern is available, you’ll find its price, format, skill information, and materials on the listing. Checkout and digital file delivery are handled through Gumroad.</p>
        <a class="text-link" href="/about/">Get to know the shop <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
    </div>

    <div class="page-shell value-grid" aria-label="What to expect">
      <article class="value-card">
        <span class="value-icon"><ListChecks size={20} aria-hidden="true" /></span>
        <h3>Clear project details</h3>
        <p>Find the skill level, materials, and file information that have been verified for each pattern.</p>
      </article>
      <article class="value-card">
        <span class="value-icon"><Download size={20} aria-hidden="true" /></span>
        <h3>Digital pattern files</h3>
        <p>Patterns are digital PDF products. The finished crocheted item is not shipped.</p>
      </article>
      <article class="value-card">
        <span class="value-icon"><Heart size={20} aria-hidden="true" /></span>
        <h3>Ideas worth sharing</h3>
        <p>Explore practical gift guides and approachable notes to help you plan your next make.</p>
      </article>
    </div>
  </section>

  {activeCategories.length > 0 && (
    <section class="section section-soft">
      <div class="page-shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Find your next project</p>
            <h2>Browse by the way you like to make.</h2>
          </div>
          <a class="text-link" href="/shop/">View all patterns <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
        <div class="category-grid">
          {activeCategories.slice(0, 6).map((category) => <CategoryCard category={category} />)}
        </div>
      </div>
    </section>
  )}

  {bestsellers.length > 0 && (
    <section class="section">
      <div class="page-shell">
        <div class="section-heading">
          <div><p class="eyebrow">Loved by makers</p><h2>Bestselling patterns.</h2></div>
          <a class="text-link" href="/shop/">See the full collection <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
        <ProductGrid products={bestsellers} />
      </div>
    </section>
  )}

  {!bestsellers.length && featuredProducts.length > 0 && (
    <section class="section">
      <div class="page-shell">
        <div class="section-heading">
          <div><p class="eyebrow">A few favorites</p><h2>Patterns to start something lovely.</h2></div>
          <a class="text-link" href="/shop/">Browse all patterns <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
        <ProductGrid products={featuredProducts} />
      </div>
    </section>
  )}

  {giftCategory && (
    <section class="section section-soft">
      <div class="page-shell editorial-feature">
        <div class="editorial-feature-media">
          <img src={giftCategory.image?.src || giftCategory.products[0].images[0].src} alt={giftCategory.image?.alt || giftCategory.products[0].images[0].alt} width={giftCategory.image?.width || giftCategory.products[0].images[0].width} height={giftCategory.image?.height || giftCategory.products[0].images[0].height} loading="lazy" decoding="async" />
        </div>
        <div class="editorial-feature-copy">
          <p class="eyebrow">The gift edit</p>
          <h2>Handmade gifts have a way of saying what words can’t.</h2>
          <p>Explore crochet gift patterns for meaningful little keepsakes, cozy comforts, and the people you love to surprise.</p>
          <a class="button button-secondary" href="/patterns/crochet-gifts/">Explore crochet gifts <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
      </div>
    </section>
  )}

  {publishedProducts.length === 0 && (
    <section class="section section-soft">
      <div class="page-shell">
        <div class="empty-state">
          <p class="eyebrow">The shop is in the making</p>
          <h2>A fresh collection is on its way.</h2>
          <p>We’re preparing the first pattern listings with accurate project details and direct Gumroad checkout links. Visit the journal for gift-planning ideas while the pattern shelf takes shape.</p>
          <a class="button button-secondary" href="/blog/">Find some inspiration <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="page-shell">
      <div class="section-heading">
        <div><p class="eyebrow">Notes for makers</p><h2>Ideas, guides, and a little inspiration.</h2></div>
        <a class="text-link" href="/blog/">Visit the journal <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
      <div class="article-grid">
        {latestPosts.map((post) => <ArticleCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>