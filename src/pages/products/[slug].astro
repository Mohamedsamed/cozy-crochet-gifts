---
import { ArrowRight, FileText, PackageOpen } from '@lucide/astro';
import ProductLayout from '../../layouts/ProductLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import GumroadButton from '../../components/GumroadButton.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { formatPrice, publishedProducts, activeCategories } from '../../lib/store';
import { siteConfig } from '../../config/site';

export function getStaticPaths() {
  return publishedProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}
const { product } = Astro.props;
const category = activeCategories.find((item) => item.slug === product.category);
const relatedProducts = publishedProducts
  .filter((item) => item.id !== product.id)
  .sort((a, b) => Number(b.category === product.category) - Number(a.category === product.category))
  .slice(0, 3);
const price = formatPrice(product.price, product.currency);
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  image: product.images.map((image) => siteConfig.publicSiteUrl ? new URL(image.src, siteConfig.publicSiteUrl).toString() : image.src),
  category: category?.title || product.category,
  offers: {
    '@type': 'Offer',
    price: product.price.toFixed(2),
    priceCurrency: product.currency,
    url: product.gumroadUrl,
  },
};
---
<ProductLayout product={product} schemas={siteConfig.publicSiteUrl ? [productSchema] : []}>
  <div class="product-layout page-shell">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Shop', href: '/shop/' },
      ...(category ? [{ label: category.title, href: '/patterns/' + category.slug + '/' }] : []),
      { label: product.name },
    ]} />

    <div class="product-detail-grid">
      <ProductGallery images={product.images} />
      <div class="product-info">
        {category && <p class="eyebrow"><a href={'/patterns/' + category.slug + '/'}>{category.title}</a></p>}
        <h1>{product.name}</h1>
        <p class="product-lede">{product.shortDescription}</p>
        <p class="product-price">
          <span>{price}</span>
          {product.compareAtPrice && <del>{formatPrice(product.compareAtPrice, product.currency)}</del>}
        </p>
        <p class="product-type">{product.fileFormat || 'Digital'} pattern · delivery through Gumroad after purchase</p>

        <div class="purchase-panel">
          <GumroadButton href={product.gumroadUrl} productId={product.id} label="Get the PDF pattern" />
        </div>
        <p class="digital-note"><strong>Digital product:</strong> this listing is for the crochet pattern file. No finished crochet item will be shipped.</p>

        <dl class="detail-list">
          {product.skillLevel && <div><dt>Skill level</dt><dd>{product.skillLevel}</dd></div>}
          {product.language && <div><dt>Language</dt><dd>{product.language}</dd></div>}
          {product.fileFormat && <div><dt>File format</dt><dd>{product.fileFormat}</dd></div>}
          {product.finishedDimensions && <div><dt>Finished size</dt><dd>{product.finishedDimensions}</dd></div>}
        </dl>
      </div>
    </div>

    <div class="product-description">
      <section>
        <p class="eyebrow">About this pattern</p>
        <h2>A thoughtful project, from first stitch to finishing touch.</h2>
        {product.description.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
      </section>

      {product.includedFiles && product.includedFiles.length > 0 && (
        <section class="section-compact">
          <p class="eyebrow">What you will receive</p>
          <h2>Files included</h2>
          <ul class="included-files">{product.includedFiles.map((file) => <li>{file}</li>)}</ul>
          <p class="checkout-note"><FileText size={15} aria-hidden="true" /> Files are delivered through Gumroad after successful checkout.</p>
        </section>
      )}

      {product.materials && product.materials.length > 0 && (
        <section class="section-compact">
          <p class="eyebrow">Gather your tools</p>
          <h2>Materials listed for this pattern</h2>
          <ul class="included-files">{product.materials.map((material) => <li>{material}</li>)}</ul>
        </section>
      )}

      {product.requiredKnowledge && product.requiredKnowledge.length > 0 && (
        <section class="section-compact">
          <p class="eyebrow">Before you begin</p>
          <h2>Skills used in this pattern</h2>
          <ul class="included-files">{product.requiredKnowledge.map((skill) => <li>{skill}</li>)}</ul>
        </section>
      )}

      <section class="digital-note">
        <PackageOpen size={18} aria-hidden="true" />
        <span><strong>Please note:</strong> this is a digital crochet pattern, not a finished handmade item. Gumroad handles checkout and sends the digital files after successful purchase.</span>
      </section>
    </div>

    <section class="product-faq">
      <p class="eyebrow">Good to know</p>
      <h2>Pattern questions</h2>
      <div class="faq-list">
        <details class="faq-item"><summary>How do I receive the pattern?<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>Checkout and file delivery are handled by Gumroad. After a successful purchase, use the receipt and download information provided by Gumroad.</p></div></details>
        <details class="faq-item"><summary>Is this a physical product?<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>No. This listing is for digital pattern files. A finished crocheted item will not be mailed.</p></div></details>
        <details class="faq-item"><summary>What files are included?<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>This listing includes: {product.includedFiles?.join(', ') || product.fileFormat || 'the files described on the Gumroad listing'}.</p></div></details>
        <details class="faq-item"><summary>Which skill level is required?<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{product.skillLevel || 'A skill level has not been specified for this pattern. Please check the Gumroad listing before purchasing.'}</p></div></details>
        <details class="faq-item"><summary>May I sell finished items made from this pattern?<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{product.licenseSummary || 'Usage rights depend on the license for this specific pattern. Check its Gumroad listing and the included file before making or selling items commercially; no commercial permission is implied here.'}</p></div></details>
        <details class="faq-item"><summary>What is the refund policy?<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>Please review the current refund terms on the Gumroad listing and the store’s <a href="/refund-policy/">refund policy</a> before ordering.</p></div></details>
      </div>
    </section>

    {relatedProducts.length > 0 && (
      <section class="related-products">
        <div class="section-heading"><div><p class="eyebrow">Keep making</p><h2>More patterns to explore.</h2></div><a class="text-link" href="/shop/">View all patterns <ArrowRight size={15} aria-hidden="true" /></a></div>
        <ProductGrid products={relatedProducts} />
      </section>
    )}

    <div class="product-share">
      {siteConfig.publicSiteUrl && <a href={'https://www.pinterest.com/pin/create/button/?url=' + encodeURIComponent(new URL(Astro.url.pathname, siteConfig.publicSiteUrl).toString()) + '&media=' + encodeURIComponent(new URL(product.images[0].src, siteConfig.publicSiteUrl).toString()) + '&description=' + encodeURIComponent(product.name)} target="_blank" rel="noreferrer">Save this pattern on Pinterest</a>}
      <a href={'mailto:?subject=' + encodeURIComponent(product.name) + '&body=' + encodeURIComponent(siteConfig.publicSiteUrl ? new URL(Astro.url.pathname, siteConfig.publicSiteUrl).toString() : Astro.url.pathname)}>Share by email</a>
    </div>
  </div>
</ProductLayout>