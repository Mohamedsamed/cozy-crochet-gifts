---
import { getCollection, render } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import BlogLayout from '../../layouts/BlogLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { publishedProducts } from '../../lib/store';
import { siteConfig } from '../../config/site';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

export function getStaticPaths() {
  return allPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const relatedPosts = allPosts.filter((item) => item.id !== post.id).slice(0, 2);
const publishedDate = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(post.data.pubDate);
const schema = siteConfig.publicSiteUrl
  ? [{
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: post.data.title,
      description: post.data.description,
      image: new URL(post.data.featuredImage, siteConfig.publicSiteUrl).toString(),
      datePublished: post.data.pubDate.toISOString(),
      ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
      publisher: { '@type': 'Organization', name: siteConfig.name },
      mainEntityOfPage: new URL('/blog/' + post.id + '/', siteConfig.publicSiteUrl).toString(),
    }]
  : [];
const shareUrl = siteConfig.publicSiteUrl
  ? new URL('/blog/' + post.id + '/', siteConfig.publicSiteUrl).toString()
  : '';
---
<BlogLayout title={post.data.title} description={post.data.description} image={post.data.featuredImage} imageAlt={post.data.imageAlt} schemas={schema}>
  <article class="page-shell">
    <div class="article-top">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Journal', href: '/blog/' }, { label: post.data.title }]} />
    </div>
    <header class="article-header">
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="article-meta"><time datetime={post.data.pubDate.toISOString()}>{publishedDate}</time></div>
    </header>

    <figure class="article-cover">
      <img src={post.data.featuredImage} alt={post.data.imageAlt} width="1200" height="800" fetchpriority="high" />
    </figure>

    <div class="article-content-shell">
      <div class="article-body"><Content />
        {shareUrl && (
          <div class="article-share">
            <a href={'https://www.pinterest.com/pin/create/button/?url=' + encodeURIComponent(shareUrl) + '&media=' + encodeURIComponent(new URL(post.data.featuredImage, siteConfig.publicSiteUrl).toString()) + '&description=' + encodeURIComponent(post.data.title)} target="_blank" rel="noreferrer">Save on Pinterest</a>
            <a href={'mailto:?subject=' + encodeURIComponent(post.data.title) + '&body=' + encodeURIComponent(shareUrl)}>Share by email</a>
          </div>
        )}
      </div>

      {headings.filter((heading) => heading.depth === 2).length > 4 && (
        <aside class="article-toc">
          <h2>In this article</h2>
          <ul>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ul>
        </aside>
      )}
    </div>
  </article>

  {publishedProducts.length > 0 && (
    <section class="section section-soft">
      <div class="page-shell">
        <div class="section-heading"><div><p class="eyebrow">Patterns for the making</p><h2>Explore a few crochet patterns.</h2></div><a class="text-link" href="/shop/">Browse the shop <ArrowRight size={15} aria-hidden="true" /></a></div>
        <ProductGrid products={publishedProducts.slice(0, 3)} />
      </div>
    </section>
  )}

  {relatedPosts.length > 0 && (
    <section class="section">
      <div class="page-shell">
        <div class="section-heading"><div><p class="eyebrow">Keep reading</p><h2>More from the journal.</h2></div></div>
        <div class="article-grid">{relatedPosts.map((item) => <ArticleCard post={item} />)}</div>
      </div>
    </section>
  )}
</BlogLayout>