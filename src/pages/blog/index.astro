---
import { getCollection } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { publishedProducts } from '../../lib/store';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = posts.find((post) => post.data.featured) || posts[0];
const otherPosts = posts.filter((post) => post.id !== featuredPost?.id);
const categories = Array.from(new Set(posts.map((post) => post.data.category)));
---
<BaseLayout title="The crochet journal" description="Useful crochet pattern guides, beginner notes, amigurumi inspiration, and thoughtful handmade gift ideas.">
  <div class="page-shell">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Journal' }]} />
    <header class="page-heading">
      <p class="eyebrow">The journal</p>
      <h1>Good ideas for the making.</h1>
      <p>Helpful notes, thoughtful gift guides, and small ways to feel more at home with your next crochet project.</p>
    </header>

    {featuredPost && (
      <section class="blog-featured" data-article-filter-card data-category={featuredPost.data.category.toLowerCase().replaceAll(' ', '-')} data-search-text={(featuredPost.data.title + ' ' + featuredPost.data.description + ' ' + featuredPost.data.category).toLowerCase()} aria-label="Featured article">
        <a href={'/blog/' + featuredPost.id + '/'}><img src={featuredPost.data.featuredImage} alt={featuredPost.data.imageAlt} width="1200" height="800" fetchpriority="high" /></a>
        <div class="blog-featured-copy">
          <p class="eyebrow">Featured · {featuredPost.data.category}</p>
          <h2><a href={'/blog/' + featuredPost.id + '/'}>{featuredPost.data.title}</a></h2>
          <p>{featuredPost.data.description}</p>
          <a class="text-link" href={'/blog/' + featuredPost.id + '/'}>Read the story <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
      </section>
    )}

    <div class="blog-tools" data-blog-search>
      <label class="search-field">
        <span class="sr-only">Search journal articles</span>
        <input type="search" placeholder="Search the journal" data-article-search />
      </label>
      <p class="catalog-count" aria-live="polite" data-article-count></p>
    </div>

    <nav class="article-category-nav" aria-label="Filter articles by category" data-article-categories>
      <button class="category-pill is-active" type="button" data-category-filter="" aria-pressed="true">All topics</button>
      {categories.map((category) => (
        <button class="category-pill" type="button" data-category-filter={category.toLowerCase().replaceAll(' ', '-')} aria-pressed="false">{category}</button>
      ))}
    </nav>

    <div class="article-grid" data-article-grid>
      {otherPosts.map((post) => <ArticleCard post={post} />)}
      {!otherPosts.length && featuredPost && <ArticleCard post={featuredPost} />}
    </div>
    <p class="no-results" data-article-empty hidden>No articles match that search. Try a different phrase or topic.</p>
    <script>
      const search = document.querySelector('[data-article-search]');
      const cards = Array.from(document.querySelectorAll('[data-article-filter-card]'));
      const count = document.querySelector('[data-article-count]');
      const filters = Array.from(document.querySelectorAll('[data-category-filter]'));
      const empty = document.querySelector('[data-article-empty]');
      let selectedCategory = '';
      const updateArticles = () => {
        const term = (search.value || '').trim().toLowerCase();
        const shown = cards.filter((card) => {
          const match = (!term || card.dataset.searchText.includes(term)) &&
            (!selectedCategory || card.dataset.category === selectedCategory);
          card.hidden = !match;
          return match;
        });
        count.textContent = shown.length + (shown.length === 1 ? ' article' : ' articles');
        empty.hidden = shown.length > 0;
      };
      search.addEventListener('input', updateArticles);
      filters.forEach((button) => button.addEventListener('click', () => {
        selectedCategory = button.dataset.categoryFilter;
        filters.forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
        filters.forEach((item) => item.classList.toggle('is-active', item === button));
        updateArticles();
      }));
      updateArticles();
    </script>
  </div>

  {publishedProducts.length > 0 && (
    <section class="section section-soft">
      <div class="page-shell">
        <div class="section-heading"><div><p class="eyebrow">For your next project</p><h2>Browse a few patterns.</h2></div><a class="text-link" href="/shop/">Visit the shop <ArrowRight size={15} aria-hidden="true" /></a></div>
        <ProductGrid products={publishedProducts.slice(0, 3)} />
      </div>
    </section>
  )}
</BaseLayout>