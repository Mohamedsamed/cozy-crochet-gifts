---
import { ArrowUpRight } from '@lucide/astro';
import { activeCategories } from '../lib/store';
import { siteConfig } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-main page-shell">
    <div class="footer-brand-column">
      <a class="brand footer-brand" href="/" aria-label="Cozy Crochet Gifts home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none">
            <path d="M20 5.5c2.2 0 3.1 4.2 3.1 7.4 2.2-2.4 5.4-5 7-3.4 1.6 1.6-1 4.8-3.4 7 3.2 0 7.4.9 7.4 3.1s-4.2 3.1-7.4 3.1c2.4 2.2 5 5.4 3.4 7-1.6 1.6-4.8-1-7-3.4 0 3.2-.9 7.4-3.1 7.4s-3.1-4.2-3.1-7.4c-2.2 2.4-5.4 5-7 3.4-1.6-1.6 1-4.8 3.4-7-3.2 0-7.4-.9-7.4-3.1s4.2-3.1 7.4-3.1c-2.4-2.2-5-5.4-3.4-7 1.6-1.6 4.8 1 7 3.4 0-3.2.9-7.4 3.1-7.4Z" fill="currentColor"/>
            <circle cx="20" cy="19.6" r="3.1" fill="#FAF8F3"/>
          </svg>
        </span>
        <span class="brand-name"><span>Cozy Crochet</span><span>Gifts</span></span>
      </a>
      <p>Small stitches, thoughtful gifts, and patterns worth keeping close.</p>
      <a class="text-link" href="/about/">A little about us <ArrowUpRight size={15} aria-hidden="true" /></a>
    </div>

    <div class="footer-link-group">
      <h2>Explore</h2>
      <a href="/shop/">Shop patterns</a>
      {activeCategories.map((category) => (
        <a href={'/patterns/' + category.slug + '/'}>{category.navLabel}</a>
      ))}
      <a href="/bundles/">Pattern bundles</a>
      <a href="/blog/">Journal</a>
    </div>

    <div class="footer-link-group">
      <h2>Help</h2>
      <a href="/faq/">Frequently asked questions</a>
      <a href="/contact/">Contact</a>
      <a href="/digital-product-policy/">Digital product policy</a>
      <a href="/refund-policy/">Refund policy</a>
      <a href="/pattern-license/">Pattern license</a>
    </div>

    <div class="footer-link-group">
      <h2>More</h2>
      <a href="/privacy-policy/">Privacy policy</a>
      <a href="/terms/">Terms</a>
      <a href="/disclaimer/">Disclaimer</a>
      {siteConfig.pinterestProfile && <a href={siteConfig.pinterestProfile} target="_blank" rel="noreferrer">Pinterest <ArrowUpRight size={13} aria-hidden="true" /></a>}
      {siteConfig.instagramProfile && <a href={siteConfig.instagramProfile} target="_blank" rel="noreferrer">Instagram <ArrowUpRight size={13} aria-hidden="true" /></a>}
    </div>
  </div>

  <div class="footer-bottom page-shell">
    <p>© {year} Cozy Crochet Gifts</p>
    <p>Made for makers, wherever you are.</p>
  </div>
</footer>