---
import { ArrowUpRight } from '@lucide/astro';
const { post } = Astro.props;
const date = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(post.data.pubDate);
const categorySlug = post.data.category.toLowerCase().replaceAll(' ', '-');
---
<article class="article-card" data-article-card data-article-filter-card data-category={categorySlug} data-search-text={(post.data.title + ' ' + post.data.description + ' ' + post.data.category).toLowerCase()}>
  <a class="article-card-image" href={'/blog/' + post.id + '/'}>
    <img src={post.data.featuredImage} alt={post.data.imageAlt} loading="lazy" decoding="async" />
  </a>
  <div class="article-card-copy">
    <p class="eyebrow">{post.data.category}</p>
    <h3><a href={'/blog/' + post.id + '/'}>{post.data.title}</a></h3>
    <span class="article-card-date">{date}</span>
    <p>{post.data.description}</p>
    <a class="text-link" href={'/blog/' + post.id + '/'}>Read article <ArrowUpRight size={15} aria-hidden="true" /></a>
  </div>
</article>