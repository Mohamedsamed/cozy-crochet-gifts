---
interface ProductImage { src: string; alt: string; width: number; height: number; }
interface Props { images: ProductImage[]; }
const { images } = Astro.props;
const first = images[0];
---
<div class="product-gallery" data-product-gallery>
  <div class="product-gallery-main">
    <img data-gallery-main src={first.src} alt={first.alt} width={first.width} height={first.height} fetchpriority="high" decoding="async" />
    <a class="gallery-zoom" data-gallery-full href={first.src} target="_blank" rel="noreferrer">Open full image</a>
  </div>
  {images.length > 1 && (
    <div class="gallery-thumbs" role="group" aria-label="Choose a product image">
      {images.map((image, index) => (
        <button class="gallery-thumb" type="button" data-gallery-thumb data-src={image.src} data-alt={image.alt} data-width={image.width} data-height={image.height} aria-label={'Show product image ' + (index + 1)} aria-pressed={index === 0 ? 'true' : 'false'}>
          <img src={image.src} alt="" width={image.width} height={image.height} loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  )}
</div>

<script lang="ts">
  document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => {
    const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]');
    const fullLink = gallery.querySelector<HTMLAnchorElement>('[data-gallery-full]');
    const buttons = gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]');
    if (!main || !fullLink) return;

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const source = button.dataset.src;
        if (!source) return;
        main.src = source;
        main.alt = button.dataset.alt || '';
        main.width = Number(button.dataset.width || main.width);
        main.height = Number(button.dataset.height || main.height);
        fullLink.href = source;
        buttons.forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
      });
    });
  });
</script>
